# ---------- Доступ к Binance USDⓈ-M Futures ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true — торговать на testnet (testnet.binancefuture.com)
BINANCE_TESTNET=false
# Переопределение адресов (обычно не нужно)
# BINANCE_REST_URL=https://fapi.binance.com
# BINANCE_WS_URL=wss://fstream.binance.com
BINANCE_RECV_WINDOW=5000

# ---------- Что охраняем ----------
# Пусто = все символы. Иначе список через запятую: BTCUSDT,ETHUSDT
ANTIAVG_SYMBOLS=
ANTIAVG_EXCLUDE_SYMBOLS=

# ---------- Правило детекции ----------
# Порог убыточности долива, % от средней цены входа. 0 = любая цена хуже входа.
ANTIAVG_LOSS_THRESHOLD_PCT=0
# false: ордера, размещённые ДО открытия позиции (вход сеткой), усреднением не считаются
# true:  считаются усреднением независимо от времени размещения
ANTIAVG_COUNT_PREEXISTING_ORDERS=false
# Позиция была открыта до запуска сервиса и время открытия неизвестно:
# skip — не реагировать (безопасно), react — реагировать
ANTIAVG_UNKNOWN_OPEN_TIME_POLICY=skip
# Восстанавливать время открытия позиций по истории сделок при старте
ANTIAVG_RECONSTRUCT_OPEN_TIME=true
ANTIAVG_RECONSTRUCT_LOOKBACK_HOURS=168
# Игнорировать доливы меньше этого объёма (в базовой валюте). 0 = не игнорировать.
ANTIAVG_MIN_AVERAGING_QTY=0

# ---------- Реакция ----------
# reduce — срезать ровно добавленный объём; close — закрыть позицию целиком
ANTIAVG_REACTION_MODE=reduce
# ВАЖНО: по умолчанию true — только логирование, без реальных ордеров.
# Поставьте false осознанно, после проверки на testnet.
ANTIAVG_DRY_RUN=true
# Окно склейки частичных исполнений одной лимитки, мс
ANTIAVG_AGGREGATION_WINDOW_MS=600
# Пауза между защитными действиями по одной позиции, мс
ANTIAVG_COOLDOWN_MS=3000
# Объём срезки меньше минимального лота биржи: skip | close
ANTIAVG_ON_QTY_BELOW_MIN=skip
# Отменять оставшиеся открытые ордера по символу после реакции
ANTIAVG_CANCEL_OPEN_ORDERS=false
ANTIAVG_CLIENT_ORDER_ID_PREFIX=antiavg

# ---------- Служебное ----------
LOG_LEVEL=info
LOG_JSON=false
ANTIAVG_RECONCILE_INTERVAL_MS=60000
ANTIAVG_SNAPSHOT_APPLY_DELAY_MS=1500
ANTIAVG_LISTEN_KEY_KEEPALIVE_MS=1800000
