# ---------- Доступ к Binance USDⓈ-M Futures ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true — торговать на testnet (testnet.binancefuture.com)
BINANCE_TESTNET=false
# Переопределение адресов (обычно не нужно)
# BINANCE_REST_URL=https://fapi.binance.com
# BINANCE_WS_URL=wss://fstream.binance.com
# Пути WebSocket после разделения базовых URL (корневые /ws и /stream отключены
# Binance 2026-04-23). Менять нужно только если Binance снова их поменяет.
# BINANCE_WS_PRIVATE_PATH=/private/ws
# BINANCE_WS_MARKET_PATH=/market/ws
BINANCE_RECV_WINDOW=5000

# ---------- Прокси ----------
# У части провайдеров HTTPS до Binance проходит, а WebSocket после рукопожатия
# молча глушится: сокет открыт, кадры не идут. Проверяется командой `npm run doctor`
# (шаг «данные по публичному WebSocket НАПРЯМУЮ»). Лечится туннелем.
# Схема обязательна: http://, https://, socks4://, socks5://
#
# Только WebSocket (REST остаётся напрямую) — обычно нужно именно это:
# BINANCE_WS_PROXY=socks5h://127.0.0.1:1080
# socks5h резолвит имя НА СТОРОНЕ ПРОКСИ — помогает при отравленном DNS.
# Прочие варианты: http://127.0.0.1:1080, socks5://127.0.0.1:1080
# Только REST (поддерживается лишь http/https):
# BINANCE_REST_PROXY=http://127.0.0.1:1080
# Оба сразу:
# BINANCE_PROXY=socks5://127.0.0.1:1080

# ---------- Сеть ----------
# Таймаут одного HTTP-запроса к Binance, мс
BINANCE_HTTP_TIMEOUT_MS=20000
# Таймаут полной загрузки exchangeInfo (ответ на несколько мегабайт), мс
BINANCE_EXCHANGE_INFO_TIMEOUT_MS=60000
# HTTP/2 выключен намеренно: на больших ответах через VPN/прокси поток рвётся
# с «TypeError: terminated». Включайте только если понимаете, зачем.
BINANCE_ALLOW_HTTP2=false
# Грузить полный справочник символов при старте. false — грузить точечно по символам
# (полезно, если тяжёлый запрос не проходит через ваш канал).
ANTIAVG_PRELOAD_EXCHANGE_INFO=true
# Пауза перед повторной попыткой запуска при сетевой ошибке, мс. 0 — не повторять.
ANTIAVG_STARTUP_RETRY_MS=15000

# ---------- Что охраняем ----------
# Пусто = все символы. Иначе список через запятую: BTCUSDT,ETHUSDT
ANTIAVG_SYMBOLS=
ANTIAVG_EXCLUDE_SYMBOLS=

# ---------- Правило детекции ----------
# Порог убыточности долива, % от средней цены входа. 0 = любая цена хуже входа.
ANTIAVG_LOSS_THRESHOLD_PCT=0
# false: ордера, размещённые ДО открытия позиции (вход сеткой), усреднением не считаются
# true:  считаются усреднением независимо от времени размещения
ANTIAVG_COUNT_PREEXISTING_ORDERS=false
# Позиция была открыта до запуска сервиса и время открытия неизвестно:
# skip — не реагировать (безопасно), react — реагировать
ANTIAVG_UNKNOWN_OPEN_TIME_POLICY=skip
# Восстанавливать время открытия позиций по истории сделок при старте
ANTIAVG_RECONSTRUCT_OPEN_TIME=true
ANTIAVG_RECONSTRUCT_LOOKBACK_HOURS=168
# Игнорировать доливы меньше этого объёма (в базовой валюте). 0 = не игнорировать.
ANTIAVG_MIN_AVERAGING_QTY=0
# Резервная детекция по REST-сверке, если исполнения не приходят по WebSocket.
# По умолчанию выключена: штатный путь — WebSocket. Включайте только как страховку.
ANTIAVG_REST_FALLBACK=false

# ---------- Реакция ----------
# reduce — срезать ровно добавленный объём; close — закрыть позицию целиком
ANTIAVG_REACTION_MODE=reduce
# ВАЖНО: по умолчанию true — только логирование, без реальных ордеров.
# Поставьте false осознанно, после проверки на testnet.
ANTIAVG_DRY_RUN=true
# Окно склейки частичных исполнений одной лимитки, мс
ANTIAVG_AGGREGATION_WINDOW_MS=600
# Пауза между защитными действиями по одной позиции, мс
ANTIAVG_COOLDOWN_MS=3000
# Объём срезки меньше минимального лота биржи: skip | close
ANTIAVG_ON_QTY_BELOW_MIN=skip
# Профилактика: снимать висящие лимитки и стопы, которые при срабатывании стали бы
# усреднением в убытке. Дешевле реакции постфактум — без рыночного ордера и
# проскальзывания. Правило то же, сетка до входа по-прежнему неприкосновенна.
ANTIAVG_CANCEL_DANGEROUS_ORDERS=true
# Замок на время просадки: пока хотя бы одна позиция в минусе, защиту нельзя
# выключить (и нельзя ослабить обходом — снять этот флаг, уйти в dry-run или
# отключить снятие опасных заявок). Открывается сам, когда позиция закрыта или
# вернулась в плюс. Это самоограничение, а не средство защиты: процесс всё равно
# можно снять из диспетчера задач. При сбое проверки замок открывается.
# Относится к десктоп-приложению; в консольной версии Ctrl+C ничего не блокирует.
ANTIAVG_LOCK_STOP_IN_DRAWDOWN=true
# Строгий вариант: при просадке не сохраняется НИ ОДНА настройка, включая эту.
# Обычный замок закрывает три конкретные лазейки, а подкрутить можно почти что
# угодно — например добавить убыточный символ в исключения. Строгий замок делает
# этот вопрос бессмысленным. Выключен по умолчанию: неудобство заметное.
ANTIAVG_LOCK_SETTINGS_IN_DRAWDOWN=false
# Просадку меньше этой суммы (USDT) замок игнорирует. 0 — любой минус запирает.
ANTIAVG_DRAWDOWN_LOCK_MIN_LOSS=0
# Предохранитель: максимум защитных ордеров в час по всему счёту.
# Если лимит достигнут, сервис перестаёт торговать и пишет ошибку в лог. 0 — без лимита.
ANTIAVG_MAX_ACTIONS_PER_HOUR=30
# Отменять оставшиеся открытые ордера по символу после реакции
ANTIAVG_CANCEL_OPEN_ORDERS=false
ANTIAVG_CLIENT_ORDER_ID_PREFIX=antiavg

# ---------- Управление риском ----------
# Все четыре правила выключены по умолчанию и действуют ТОЛЬКО на позиции,
# открытые при работающем сервисе. Депозит везде — totalWalletBalance
# (без нереализованного PnL). Действия тратят общий предохранитель.
#
# 1. Номинал позиции не выше «плечо × депозит». Превышение срезается по рынку,
#    в том числе при доливе в прибыльную позицию. Потолок — на КАЖДУЮ позицию.
ANTIAVG_MAX_POSITION_ENABLED=false
ANTIAVG_MAX_POSITION_LEVERAGE=3
# 2. Если через ANTIAVG_DEFAULT_STOP_DELAY_MS после открытия позиции стопа нет,
#    сервис ставит свой (STOP_MARKET, closePosition). Проверка —
#    один раз за жизнь позиции. Цена уже за уровнем — позиция закрывается по рынку.
ANTIAVG_DEFAULT_STOP_ENABLED=false
ANTIAVG_DEFAULT_STOP_PCT=1
# По какой цене срабатывают стопы СЕРВИСА: CONTRACT_PRICE | MARK_PRICE.
# CONTRACT_PRICE (по умолчанию) — цена последней сделки: мгновенно и ровно там,
# где видно в стакане. Так же Binance ставит стопы, выставленные руками, поэтому
# свои и наши стопы ведут себя одинаково.
# MARK_PRICE — медиана из индекса и цены сделок с данными раз в секунду: не
# ловится на быстрые проколы и совпадает с ценой, по которой считается
# ликвидация, но срабатывает с задержкой ~1 с.
ANTIAVG_STOP_WORKING_TYPE=CONTRACT_PRICE
ANTIAVG_DEFAULT_STOP_DELAY_MS=2000
# 3. Снятый ВРУЧНУЮ стоп возвращается на прежнюю цену. Сработавший (FILLED) и
#    снятый биржей при закрытии позиции (EXPIRED) не восстанавливаются.
#    Больше 10 возвратов в час по одной позиции сервис не делает.
ANTIAVG_PROTECT_STOP_ORDERS=false
# 4. Риск = |вход − стоп| × объём. Включено — стоп не уезжает дальше предела,
#    а если цена туда уже ушла, позиция закрывается по рынку. Выключено —
#    только уведомление в трее при смене состояния: превышено / норма.
ANTIAVG_MAX_RISK_ENABLED=false
ANTIAVG_MAX_RISK_PCT=2
# Сколько держать значение депозита из кеша, мс.
ANTIAVG_BALANCE_CACHE_MS=30000

# ---------- Служебное ----------
LOG_LEVEL=info
LOG_JSON=false
# Печатать КАЖДОЕ сырое событие WebSocket. Включайте, если сервис молчит и надо
# понять, доходят ли исполнения от Binance вообще.
ANTIAVG_LOG_RAW_EVENTS=false
# Периодический отчёт: счётчики событий, исполнений, срабатываний. 0 — выключить.
ANTIAVG_STATS_INTERVAL_MS=300000
ANTIAVG_RECONCILE_INTERVAL_MS=60000
ANTIAVG_SNAPSHOT_APPLY_DELAY_MS=1500
# Сколько поток должен молчать, чтобы расхождение при сверке считалось признаком
# мёртвого WebSocket, а не гонкой снимка и исполнения.
ANTIAVG_DESYNC_RECONNECT_SILENCE_MS=20000
ANTIAVG_LISTEN_KEY_KEEPALIVE_MS=1800000
# Сколько миллисекунд полного молчания WebSocket (нет ни сообщений, ни ping)
# считать признаком мёртвого потока. Binance шлёт ping примерно раз в 3 минуты.
ANTIAVG_WS_SILENCE_TIMEOUT_MS=200000
