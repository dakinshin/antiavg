{
  "name": "antiavg-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Окно и трей для AntiAvg — защиты от усреднения в убытке",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "build:core": "npm --prefix .. run build",
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:core && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder --win --mac",
    "dist:win": "npm run build && electron-builder --win",
    "fix:wincodesign": "node scripts/fix-wincodesign.mjs",
    "dist:win:noedit": "npm run build && electron-builder --win -c.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "author": "Avanpost.io"
}
